# Postgres connection string (required)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/rust_home_template?sslmode=disable

# HTTP bind address; accepts :8080 or host:port (default :8080)
ADDR=:8080

# Runtime environment: development | production (default development)
# Production sets the Secure flag on session cookies.
APP_ENV=development

# Allow multiple household accounts to register (default true).
# Set to false to allow only the initial bootstrap account to register.
ALLOW_OPEN_REGISTRATION=true
