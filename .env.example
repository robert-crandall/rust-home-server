# Postgres connection string (required)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/rust_home_server?sslmode=disable

# HTTP bind address; accepts :8080 or host:port (default :8080)
ADDR=:8080

# Runtime environment: development | production (default development)
# Production sets the Secure flag on session cookies.
APP_ENV=development

# Allow open registration (default false: only the first account can register).
# Set to true for a multi-user app.
# ALLOW_OPEN_REGISTRATION=false

# Optional: Cloudflare Access JWT authentication (must set both or neither).
# When configured, requests with a valid Cf-Access-Jwt-Assertion header (or
# CF_Authorization cookie) auto-provision and authenticate users by email.
# CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
# CF_ACCESS_AUD=your-application-audience-tag

# Optional: shared read-only directory containing `users.yaml` and raster avatar
# files (png, jpg, webp, gif, avif) to standardize display names and avatars
# across multiple homelab containers.
# HOUSEHOLD_DIR=/etc/household

